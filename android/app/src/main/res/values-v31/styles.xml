<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:statusBarColor">@color/absports_maroon</item>
        <item name="android:navigationBarColor">@color/absports_canvas</item>
        <item name="android:windowBackground">@color/absports_canvas</item>
        <item name="android:colorPrimary">@color/absports_maroon</item>
        <item name="android:colorAccent">@color/absports_gold</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Android 12+ system splash: keep full circular crest inside safe zone -->
        <item name="android:windowSplashScreenBackground">@color/absports_maroon</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/absports_maroon</item>
    </style>
</resources>
